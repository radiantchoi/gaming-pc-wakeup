# Environment for gaming-pc-wakeup. Copy this file, fill in WOL_MAC and
# WOL_HOST, and keep it out of the repository.
#   Pi:     /etc/gaming-pc-wakeup.env   (read by systemd EnvironmentFile)
#   Termux: $HOME/gaming-pc-wakeup.env  (sourced by deploy/termux/boot.sh)
# Plain KEY=value lines, no quotes, no "export".

# Required: MAC address of the gaming PC's Ethernet NIC.
WOL_MAC=AA:BB:CC:DD:EE:FF

# Required: IP address or hostname of the gaming PC (used by GET /status).
WOL_HOST=192.168.0.10

# Broadcast address the magic packet is sent to. On Wi-Fi hosts or hosts
# with several interfaces, prefer the subnet broadcast, e.g. 192.168.0.255.
WOL_BROADCAST=255.255.255.255

# UDP port the magic packet is sent to.
WOL_PORT=9

# TCP port on the PC that is open when it is up (3389 = RDP).
WOL_STATUS_PORT=3389

# Seconds to wait for the TCP connect in GET /status.
WOL_STATUS_TIMEOUT=1.0

# Optional: if set, POST /wake requires header "X-Token: <value>".
# Leave empty to disable.
WOL_TOKEN=
